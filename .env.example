# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# ONLY the public anon key belongs here. NEVER put the service_role key in a VITE_ variable -
# everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional. Admins can sign in with a plain username: "admin" is sent to Supabase as admin@<this domain>.
# Create the Supabase user with that exact address. Default: example.com
# VITE_ADMIN_EMAIL_DOMAIN=example.com
