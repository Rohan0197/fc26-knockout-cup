# Copy to .env.local and fill in from Supabase -> Project Settings -> API.
# ONLY the public anon key belongs here. NEVER put the service_role key in a VITE_ variable -
# everything prefixed VITE_ is shipped to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
